# Copy this file to .env.local and fill in your key. Never share or commit .env.local.

# Which AI answers: gemini (free tier), anthropic (Claude), or mock (fake dishes for testing)
AI_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Only needed if AI_PROVIDER=anthropic. Key from https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
